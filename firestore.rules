rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Branch Managers collection
    match /managers/{managerId} {
      allow get, delete, create, update: if isValidId(managerId);
      allow list: if true;
    }

    // Team members & permissions collection
    match /team/{memberId} {
      allow get, delete, create, update: if isValidId(memberId);
      allow list: if true;
    }

    // Audit logs collection
    match /audit_logs/{logId} {
      allow get, delete, create, update: if isValidId(logId);
      allow list: if true;
    }

    // Sleepers collection
    match /sleepers/{sleeperId} {
      allow get, delete, create, update: if isValidId(sleeperId);
      allow list: if true;
    }

    // Contratos collection
    match /contratos/{contratoId} {
      allow get, delete, create, update: if isValidId(contratoId);
      allow list: if true;
    }

    // Onboarding 30-day journey collection
    match /onboardings/{onboardingId} {
      allow get, delete, create, update: if isValidId(onboardingId);
      allow list: if true;
    }

    // Interactions communication log
    match /interactions/{interactionId} {
      allow get, delete, create, update: if isValidId(interactionId);
      allow list: if true;
    }

    // Client and case comments
    match /comments/{commentId} {
      allow get, delete, create, update: if isValidId(commentId);
      allow list: if true;
    }

    // Gift cards and guest passes
    match /gifts/{giftId} {
      allow get, delete, create, update: if isValidId(giftId);
      allow list: if true;
    }

    // Templates and configuration
    match /plantillas/{plantillaId} {
      allow get, delete, create, update: if isValidId(plantillaId);
      allow list: if true;
    }

    match /config_mensajes/{configId} {
      allow get, delete, create, update: if isValidId(configId);
      allow list: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
